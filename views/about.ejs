<header class="page-head">
  <div class="container animate-on-scroll">
    <h1 class="page-title"><%= t('Tentang Saya', 'About Me') %></h1>
    <p class="page-subtitle"><%= typeof profile !== 'undefined' && profile.looking_for ? tField(profile, 'looking_for') : 'Get to know the person behind the code.' %></p>
  </div>
</header>

<section class="section">
  <div class="container">
    <div class="about-grid">
      <aside class="about-aside animate-on-scroll">
        <% if (typeof profile !== 'undefined' && profile.profile_image) { %>
          <div class="portrait">
            <img src="<%= profile.profile_image %>" alt="<%= profile.full_name %>" onerror="handleImageError(this)">
          </div>
        <% } %>
        
        <div class="fact-card">
          <h2>Profile Facts</h2>
          <dl>
            <dt>Name</dt>
            <dd><%= typeof profile !== 'undefined' && profile.full_name ? profile.full_name : 'Alvi' %></dd>
            
            <dt>Role</dt>
            <dd><%= typeof profile !== 'undefined' && profile.tagline ? profile.tagline : 'Full Stack Developer' %></dd>
            
            <% if (typeof profile !== 'undefined' && profile.location) { %>
              <dt>Location</dt>
              <dd><%= profile.location %></dd>
            <% } %>
            
            <% if (typeof profile !== 'undefined' && profile.email) { %>
              <dt>Email</dt>
              <dd><%= profile.email %></dd>
            <% } %>
          </dl>
          
          <div style="margin-top: 1.5rem;">
            <a href="/cv" class="btn btn-primary btn-block link-arrow">View ATS CV <span>→</span></a>
          </div>
        </div>
      </aside>
      
      <div class="about-text animate-on-scroll">
        <% if (typeof profile !== 'undefined' && profile.about_summary) { %>
          <p class="lead"><%- nl2br(tField(profile, 'about_summary')) %></p>
        <% } %>

        <% if (typeof profile !== 'undefined' && profile.looking_for) { %>
          <div class="callout">
            <h2>Target Role</h2>
            <p><%- nl2br(tField(profile, 'looking_for')) %></p>
          </div>
        <% } %>

        <div class="about-block prose">
          <h2>My Background</h2>
          <% if (typeof profile !== 'undefined' && (profile.bio || profile.bio_en)) { %>
            <%- nl2br(tField(profile, 'bio')) %>
          <% } else { %>
            <p>Welcome to my portfolio! I am a passionate developer dedicated to creating meaningful digital experiences.</p>
          <% } %>
        </div>

        <div class="about-block">
          <h2>Technical Skills</h2>
          <% if (typeof skillsByCategory !== 'undefined' && Object.keys(skillsByCategory).length > 0) { %>
            <% Object.keys(skillsByCategory).forEach(category => { %>
              <div class="stack-row">
                <div class="stack-cat"><%= category %></div>
                <ul class="stack-items">
                  <% skillsByCategory[category].forEach(skill => { %>
                    <li class="used"><%= skill.name %></li>
                  <% }) %>
                </ul>
              </div>
            <% }) %>
          <% } else { %>
            <div class="empty">
              <p>No skills have been added yet.</p>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</section>
