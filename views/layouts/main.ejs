<% if (typeof getImageUrl === 'undefined') { getImageUrl = function(url) { return url; }; } %>
<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'id' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#F4F1EA">
  <%- include('../partials/meta') %>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <noscript><style>.animate-on-scroll { opacity: 1 !important; transform: none !important; }</style></noscript>
</head>
<body>
  <%
    const _lang = typeof lang !== 'undefined' ? lang : 'id';
    const _cur = typeof currentPage !== 'undefined' ? currentPage : '';
    const _nav = (typeof nav !== 'undefined' && nav) ? nav : { journey: true, certificates: true };
    const _prof = (typeof profile !== 'undefined' && profile) ? profile : {};
    const _tt = (idText, enText) => (_lang === 'en' ? enText : idText);
    const _items = [
      { key: 'home', href: '/', label: _tt('Beranda', 'Home'), show: true },
      { key: 'about', href: '/about', label: _tt('Tentang', 'About'), show: true },
      { key: 'projects', href: '/projects', label: _tt('Proyek', 'Projects'), show: true },
      { key: 'certificates', href: '/certificates', label: _tt('Sertifikat', 'Certificates'), show: _nav.certificates },
      { key: 'journey', href: '/journey', label: _tt('Perjalanan', 'Journey'), show: _nav.journey },
      { key: 'contact', href: '/contact', label: _tt('Kontak', 'Contact'), show: true }
    ].filter(i => i.show);
  %>
  <a class="skip-link" href="#main"><%= _tt('Lewati ke konten', 'Skip to content') %></a>

  <header class="navbar" id="navbar">
    <nav class="container nav-container" aria-label="<%= _tt('Navigasi utama', 'Main navigation') %>">
      <a href="/" class="nav-logo" aria-label="<%= _tt('Beranda', 'Home') %>"><%= typeof displayName === 'function' ? displayName(_prof) : 'Malvix' %></a>
      <button class="nav-toggle" id="navToggle" type="button" aria-label="<%= _tt('Buka menu', 'Toggle menu') %>" aria-controls="navLinks" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
      <ul class="nav-links" id="navLinks">
        <% _items.forEach(i => { %>
          <li><a href="<%= i.href %>" class="<%= _cur === i.key ? 'active' : '' %>" <%- _cur === i.key ? 'aria-current="page"' : '' %>><%= i.label %></a></li>
        <% }) %>
        <li class="lang-switch" role="group" aria-label="<%= _tt('Bahasa', 'Language') %>">
          <a href="?lang=id" hreflang="id" lang="id" <%- _lang === 'id' ? 'aria-current="true"' : '' %>>ID</a>
          <a href="?lang=en" hreflang="en" lang="en" <%- _lang === 'en' ? 'aria-current="true"' : '' %>>EN</a>
        </li>
        <% if (typeof user !== 'undefined' && user) { %>
          <li><a href="/admin">Dashboard</a></li>
        <% } %>
      </ul>
    </nav>
  </header>

  <main id="main">
    <%- body %>
  </main>

  <footer class="footer">
    <div class="container">
      <div class="footer-row">
        <a href="/" class="footer-logo"><%= typeof displayName === 'function' ? displayName(_prof) : 'Malvix' %></a>
        <ul class="footer-links">
          <% _items.forEach(i => { %><li><a href="<%= i.href %>"><%= i.label %></a></li><% }) %>
          <% if (_prof.github_url) { %><li><a href="<%= _prof.github_url %>" target="_blank" rel="noopener noreferrer">GitHub</a></li><% } %>
          <% if (_prof.linkedin_url) { %><li><a href="<%= _prof.linkedin_url %>" target="_blank" rel="noopener noreferrer">LinkedIn</a></li><% } %>
        </ul>
      </div>
      <p class="footer-note">&copy; <%= new Date().getFullYear() %> <%= _prof.full_name || 'Muhammad Alvi Kirana Zulfan Nazal' %>. <%= _tt('Dibuat dengan Node.js, Express, dan MySQL.', 'Built with Node.js, Express and MySQL.') %></p>
    </div>
  </footer>

  <script src="/js/imageUtils.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
