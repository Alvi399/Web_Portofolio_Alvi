<header class="case-head">
  <div class="container animate-on-scroll">
    <a href="/projects" class="back-link">&larr; <%= t('Kembali ke Proyek', 'Back to Projects') %></a>
    <h1 class="case-title"><%= project.title %></h1>
    
    <% const _demoUrl = project.demo_url || project.project_url; %>
    <% if (project.github_url || _demoUrl) { %>
      <div class="case-actions">
        <% if (_demoUrl) { %>
          <a href="<%= _demoUrl %>" target="_blank" rel="noopener noreferrer" class="btn btn-primary link-arrow">
            Live App <span>&#8599;</span>
          </a>
        <% } %>
        <% if (project.github_url) { %>
          <a href="<%= project.github_url %>" target="_blank" rel="noopener noreferrer" class="btn">
            Source Code
          </a>
        <% } %>
      </div>
    <% } %>
  </div>
</header>

<div class="container case-body">
  <aside class="case-meta animate-on-scroll">
    <dl>
      <dt>Role</dt>
      <dd><%= tField(project, 'role') || 'Full Stack Developer' %></dd>
      
      <% if (project.technologies && Array.isArray(project.technologies) && project.technologies.length > 0) { %>
        <dt>Stack</dt>
        <dd>
          <% project.technologies.forEach(tech => { %>
            <span class="tag"><%= tech %></span>
          <% }) %>
        </dd>
      <% } %>
      
      <% if (project.github_url) { %>
        <dt>Repository</dt>
        <dd><a href="<%= project.github_url %>" target="_blank" style="text-decoration: underline;">GitHub</a></dd>
      <% } %>
      
      <% if (_demoUrl) { %>
        <dt>Live Link</dt>
        <dd><a href="<%= _demoUrl %>" target="_blank" style="text-decoration: underline;">View App</a></dd>
      <% } %>
    </dl>
  </aside>
  
  <div class="case-content animate-on-scroll">
    <% if (project.image || project.image) { %>
      <div class="case-hero">
        <img src="<%= getImageUrl(project.image || project.image) %>" alt="<%= project.title %>" onerror="handleImageError(this)">
      </div>
    <% } %>
    
    <div class="case-block prose">
      <h2>Overview</h2>
      <%- nl2br(tField(project, 'description')) %>
    </div>
    
    <% const _story = [
      { heading: typeof lang !== 'undefined' && lang === 'en' ? 'Problem Space' : 'Masalah', text: tField(project, 'problem') },
      { heading: typeof lang !== 'undefined' && lang === 'en' ? 'Impact & Results' : 'Dampak / Hasil', text: tField(project, 'impact') }
    ].filter(b => b.text && String(b.text).trim()); %>
    
    <% _story.forEach(block => { %>
      <div class="case-block prose">
        <h2><%= block.heading %></h2>
        <%- nl2br(block.text) %>
      </div>
    <% }) %>
  </div>
</div>
