<header class="page-head">
  <div class="container animate-on-scroll">
    <h1 class="page-title"><%= t('Proyek', 'Projects') %></h1>
    <p class="page-subtitle">A showcase of my recent work and open source contributions.</p>
    <div style="margin-top: 1.5rem; max-width: 400px;">
      <input type="text" id="projectFilter" placeholder="Filter by technology..." class="form-control filter-input">
    </div>
  </div>
</header>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const filterInput = document.getElementById('projectFilter');
  const rows = document.querySelectorAll('.proj-row');
  
  if (filterInput) {
    filterInput.addEventListener('input', (e) => {
      const term = e.target.value.toLowerCase();
      rows.forEach(row => {
        const text = row.innerText.toLowerCase();
        row.style.display = text.includes(term) ? 'grid' : 'none';
      });
    });
  }
});
</script>

<section class="section">
  <div class="container">
    <div class="proj-list animate-on-scroll">
      <% if (typeof projects !== 'undefined' && projects.length > 0) { %>
        <% projects.forEach((project, i) => { %>
          <div class="proj-row">
            <div class="proj-num"><%= String(i + 1).padStart(2, '0') %></div>
            <div class="proj-body">
              <h3 class="proj-title"><a href="/projects/<%= project.slug %>"><%= project.title %></a></h3>
              <p class="proj-excerpt"><%= tField(project, 'description') ? tField(project, 'description').substring(0, 120) + (tField(project, 'description').length > 120 ? '...' : '') : '' %></p>
              
              <% if (project.technologies && Array.isArray(project.technologies) && project.technologies.length > 0) { %>
                <div class="tag-list">
                  <% project.technologies.slice(0, 4).forEach(tech => { %>
                    <span class="tag"><%= tech %></span>
                  <% }) %>
                </div>
              <% } %>
            </div>
            
            <div class="proj-links">
              <a href="/projects/<%= project.slug %>" class="btn btn-sm link-arrow">Case Study <span>→</span></a>
              <% if (project.project_url) { %>
                <a href="<%= project.project_url %>" target="_blank" class="btn btn-sm btn-outline">Live App</a>
              <% } %>
              <% if (project.github_url) { %>
                <a href="<%= project.github_url %>" target="_blank" class="btn btn-sm btn-outline">Code</a>
              <% } %>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="empty">
          <p>No projects found.</p>
        </div>
      <% } %>
    </div>

    <% if (typeof pagination !== 'undefined' && pagination.totalPages > 1) { %>
      <div class="pagination-bar">
        <% if (pagination.page > 1) { %>
          <a href="?page=<%= pagination.page - 1 %>" class="btn btn-sm">&larr; Prev</a>
        <% } %>
        <span>
          Page <%= pagination.page %> / <%= pagination.totalPages %>
        </span>
        <% if (pagination.page < pagination.totalPages) { %>
          <a href="?page=<%= pagination.page + 1 %>" class="btn btn-sm">Next &rarr;</a>
        <% } %>
      </div>
    <% } %>
  </div>
</section>
