<div class="page-header-flex">
  <h2>Manage Journey</h2>
  <a href="/admin/journey/create" class="btn btn-primary">➕ Add New Event</a>
</div>

<div class="table-container">
  <table class="admin-table">
    <thead>
      <tr>
        <th>Date</th>
        <th>Image</th>
        <th>Title</th>
        <th>Category</th>
        <th>Description</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% if (journeys && journeys.length > 0) { %>
        <% journeys.forEach(item => { %>
          <tr>
            <td>
              <%= item.date ? new Date(item.date).toLocaleDateString() : '-' %> 
              <% if (item.is_current) { %>
                <span class="badge badge-success">Present</span>
              <% } else if (item.end_date) { %>
                - <%= new Date(item.end_date).toLocaleDateString() %>
              <% } %>
            </td>
            <td>
              <% if (item.image) { %>
                <img src="<%= getImageUrl(item.image) %>" alt="" class="table-thumb" style="width: 50px; height: 50px; object-fit: cover;" onerror="handleImageError(this)">
              <% } else { %>
                <span class="text-muted">-</span>
              <% } %>
            </td>
            <td><strong><%= item.title %></strong></td>
            <td><span class="badge badge-<%= item.category === 'education' ? 'info' : 'primary' %>"><%= item.category === 'education' ? 'Education' : 'Experience' %></span></td>
            <% const safeDesc = item.description || ''; %>
            <td><%= safeDesc.length > 60 ? safeDesc.substring(0, 60) + '...' : safeDesc %></td>
            <td>
              <a href="/admin/journey/<%= item.id %>/edit" class="btn-icon" title="Edit Journey Event">✏️ Edit</a>
              <form action="/admin/journey/<%= item.id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Apakah Anda yakin ingin menghapus data journey ini?');">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn-icon btn-icon-danger" title="Delete Journey Event">🗑️ Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
      <% } else { %>
        <tr><td colspan="6" class="text-center">No journey events found. <a href="/admin/journey/create">Add one now</a>.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>
