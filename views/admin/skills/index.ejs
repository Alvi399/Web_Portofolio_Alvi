<div class="page-header-flex">
  <h2>Manage Skills</h2>
  <a href="/admin/skills/create" class="btn btn-primary">➕ Add New Skill</a>
</div>

<div class="table-container">
  <table class="admin-table">
    <thead>
      <tr>
        <th style="width: 50px">Order</th>
        <th>Category</th>
        <th>Icon</th>
        <th>Name</th>
        <th>Proficiency</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody class="sortable-tbody" data-reorder-route="/admin/skills/reorder">
      <% if (skills && skills.length > 0) { %>
        <% skills.forEach(skill => { %>
          <tr data-id="<%= skill.id %>">
            <td style="cursor: grab;" class="drag-handle" title="Drag to reorder">
              ☰ <span class="order-number"><%= skill.sort_order || 0 %></span>
            </td>
            <td><span class="badge badge-info"><%= skill.category %></span></td>
            <td>
              <% if (skill.image) { %>
                <img src="<%= getImageUrl(skill.image) %>" alt="<%= skill.name %>" style="width: 24px; height: 24px; object-fit: contain;" onerror="handleImageError(this)">
              <% } else { %>
                <%= skill.icon || '⚡' %>
              <% } %>
            </td>
            <td><strong><%= skill.name %></strong></td>
            <td><%= skill.proficiency %>%</td>
            <td>
              <a href="/admin/skills/<%= skill.id %>/edit" class="btn-icon" title="Edit Skill">✏️ Edit</a>
              <form action="/admin/skills/<%= skill.id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Apakah Anda yakin ingin menghapus skill ini?');">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn-icon btn-icon-danger" title="Delete Skill">🗑️ Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
      <% } else { %>
        <tr><td colspan="6" class="text-center">No skills found. <a href="/admin/skills/create">Add one now</a>.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>
