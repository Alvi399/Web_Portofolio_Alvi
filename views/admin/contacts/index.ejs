<div class="page-header-flex">
  <h2>Messages</h2>
</div>

<div class="table-container">
  <table class="admin-table">
    <thead>
      <tr>
        <th>Date</th>
        <th>Name</th>
        <th>Subject</th>
        <th>Status</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% if (contacts.length > 0) { %>
        <% contacts.forEach(contact => { %>
          <tr class="<%= contact.is_read ? '' : 'font-bold bg-light' %>">
            <td><%= new Date(contact.createdAt).toLocaleDateString() %></td>
            <td>
              <div><%= contact.name %></div>
              <small class="text-muted"><%= contact.email %></small>
            </td>
            <td><%= contact.subject || '(No Subject)' %></td>
            <td>
              <% if (contact.is_read) { %>
                <span class="badge badge-neutral">Read</span>
              <% } else { %>
                <span class="badge badge-warning">New</span>
              <% } %>
            </td>
            <td>
              <div class="action-group">
                <a href="/admin/contacts/<%= contact.id %>" class="btn-icon" title="View">👁️</a>
                <form action="/admin/contacts/<%= contact.id %>/delete" method="POST" onsubmit="return confirm('Delete message?');" style="display:inline;">
                  <button type="submit" class="btn-icon btn-icon-danger" title="Delete">🗑️</button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      <% } else { %>
        <tr>
          <td colspan="5" class="text-center">No messages yet.</td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>
