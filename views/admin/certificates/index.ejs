<div class="page-header-flex">
  <h2>Manage Certificates</h2>
  <a href="/admin/certificates/create" class="btn btn-primary">➕ Add New Certificate</a>
</div>

<div class="table-container">
  <table class="admin-table">
    <thead>
      <tr>
        <th>Date</th>
        <th>Title</th>
        <th>Issuer</th>
        <th>Category</th>
        <th>Highlight</th>
        <th>Links</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% if (certificates && certificates.length > 0) { %>
        <% certificates.forEach(cert => { %>
          <tr>
            <td><%= cert.date ? new Date(cert.date).toLocaleDateString() : '-' %></td>
            <td><strong><%= cert.title %></strong></td>
            <td><%= cert.issuer %></td>
            <td><span class="badge badge-info"><%= cert.category %></span></td>
            <td>
              <% if (cert.is_highlight) { %>
                <span class="badge badge-success">Highlighted</span>
              <% } else { %>
                <span class="badge badge-neutral">Normal</span>
              <% } %>
            </td>
            <td>
              <% if (cert.credential_url) { %> <a href="<%= cert.credential_url %>" target="_blank" class="text-link">Credential</a> <% } %>
              <% if (cert.image) { %> <a href="<%= getImageUrl(cert.image) %>" target="_blank" class="text-link">Image</a> <% } %>
            </td>
            <td>
              <a href="/admin/certificates/<%= cert.id %>/edit" class="btn-icon" title="Edit Certificate">✏️ Edit</a>
              <form action="/admin/certificates/<%= cert.id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Apakah Anda yakin ingin menghapus sertifikat ini?');">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn-icon btn-icon-danger" title="Delete Certificate">🗑️ Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
      <% } else { %>
        <tr><td colspan="7" class="text-center">No certificates found. <a href="/admin/certificates/create">Add one now</a>.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>
