<section class="hero">
  <div class="container hero-container">
    <div class="hero-content">
      <h1 class="hero-title">
        Hello, I'm <span class="highlight"><%= typeof profile !== 'undefined' && profile.full_name ? profile.full_name : 'Alvi' %></span>
      </h1>
      <p class="hero-subtitle">
        <%= typeof profile !== 'undefined' && profile.tagline ? profile.tagline : 'Full Stack Developer' %>
      </p>
      <p class="hero-bio">
        <%= typeof profile !== 'undefined' && profile.bio ? profile.bio.substring(0, 150) + '...' : 'Building digital experiences that matter.' %>
      </p>
      <div class="hero-cta">
        <a href="/projects" class="btn btn-primary">View Work</a>
        <a href="/contact" class="btn btn-outline">Contact Me</a>
      </div>
    </div>
    <div class="hero-image">
      <% if (typeof profile !== 'undefined' && profile.profile_image) { %>
        <img src="<%= profile.profile_image %>" alt="<%= profile.full_name %>" class="profile-img">
      <% } else { %>
        <div class="profile-placeholder">
          <span><%= typeof profile !== 'undefined' && profile.full_name ? profile.full_name.charAt(0) : 'A' %></span>
        </div>
      <% } %>
    </div>
  </div>
</section>

<section class="section featured-projects">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">Featured Projects</h2>
      <a href="/projects" class="section-link">View All &rarr;</a>
    </div>
    
    <div class="projects-grid">
      <% if (projects && projects.length > 0) { %>
        <% projects.forEach(project => { %>
          <article class="project-card">
            <div class="project-image">
              <% if (project.image) { %>
                <img src="<%= project.image %>" alt="<%= project.title %>">
              <% } else { %>
                <div class="project-placeholder">
                  <span><%= project.title.charAt(0) %></span>
                </div>
              <% } %>
            </div>
            <div class="project-content">
              <h3 class="project-title"><a href="/projects/<%= project.slug %>"><%= project.title %></a></h3>
              <div class="project-tags">
                <% if (project.technologies && Array.isArray(project.technologies) && project.technologies.length > 0) { %>
                  <% project.technologies.slice(0, 3).forEach(tech => { %>
                    <span class="tag"><%= tech %></span>
                  <% }) %>
                <% } %>
              </div>
              <p class="project-excerpt"><%= (project.description || '').substring(0, 100) %>...</p>
              <div class="project-links">
                <a href="/projects/<%= project.slug %>" class="link-text">Read More</a>
                <% if (project.github_url) { %>
                  <a href="<%= project.github_url %>" target="_blank" class="icon-link" title="GitHub">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
                  </a>
                <% } %>
              </div>
            </div>
          </article>
        <% }) %>
      <% } else { %>
        <p class="no-projects">No projects featured yet.</p>
      <% } %>
    </div>
  </div>
</section>

<section class="section skills-section">
  <div class="container">
    <h2 class="section-title center">Skills & Expertise</h2>
    <div class="skills-grid">
       <% if (skills && skills.length > 0) { %>
          <% skills.forEach(skill => { %>
            <div class="skill-card">
              <span class="skill-icon"><%= skill.icon || '🔹' %></span>
              <span class="skill-name"><%= skill.name %></span>
              <div class="skill-level">
                <div class="skill-progress" style="width: <%= skill.proficiency %>%"></div>
              </div>
            </div>
          <% }) %>
       <% } %>
    </div>
  </div>
</section>
