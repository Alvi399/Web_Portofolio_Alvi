<header class="page-head">
  <div class="container animate-on-scroll">
    <h1 class="page-title"><%= t('Perjalanan Karir', 'My Journey') %></h1>
    <p class="page-subtitle">A timeline of my professional and personal growth</p>
  </div>
</header>

<section class="section">
  <div class="container">
    <div class="tl animate-on-scroll">
      <% if (typeof journeys !== 'undefined' && journeys.length > 0) { %>
        <% journeys.forEach((item, index) => { %>
          <div class="tl-item">
            <div class="tl-date">
              <% const lang = typeof _lang !== 'undefined' ? _lang : 'en'; %>
              <% const sD = new Date(item.date).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' }); %>
              <% const eD = item.is_current ? (lang === 'id' ? 'Sekarang' : 'Present') : (item.end_date ? new Date(item.end_date).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' }) : ''); %>
              <%= eD ? `${sD} - ${eD}` : sD %>
            </div>
            <div class="tl-content">
              <h3 class="tl-title"><%= tField(item, 'title') || item.title %></h3>
              <p class="tl-body"><%= tField(item, 'description') || item.description %></p>
              
              <% if (item.image) { %>
                <img src="<%= getImageUrl(item.image) %>" alt="<%= item.title %>" class="tl-img" onerror="handleImageError(this)">
              <% } %>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="empty">
          <p>Journey details coming soon...</p>
        </div>
      <% } %>
    </div>

    <% if (typeof pagination !== 'undefined' && pagination.totalPages > 1) { %>
      <div class="pagination-bar" style="margin-top: 2.5rem; display: flex; gap: 0.75rem; align-items: center; justify-content: center; font-family: var(--font-mono); font-size: 0.9rem;">
        <% if (pagination.page > 1) { %>
          <a href="?page=<%= pagination.page - 1 %>" class="btn btn-sm" style="background: var(--paper); border: var(--line); box-shadow: var(--shadow);">&larr; <%= t('Sebelumnya', 'Prev') %></a>
        <% } %>
        
        <span style="font-weight: 700; color: var(--ink); padding: 0.35rem 0.75rem; background: var(--surface); border: var(--line);">
          <%= t('Halaman', 'Page') %> <%= pagination.page %> / <%= pagination.totalPages %> (<%= pagination.totalItems %> <%= t('Milestone', 'Milestones') %>)
        </span>
        
        <% if (pagination.page < pagination.totalPages) { %>
          <a href="?page=<%= pagination.page + 1 %>" class="btn btn-sm" style="background: var(--paper); border: var(--line); box-shadow: var(--shadow);"><%= t('Berikutnya', 'Next') %> &rarr;</a>
        <% } %>
      </div>
    <% } %>
  </div>
</section>

